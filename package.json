{
  "name": "schale-ledger",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "types": "wrangler types --strict-vars=false",
    "check": "npm run types && tsc --noEmit && node --check < src/browser.client",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "jose": "6.2.18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261123.1-beta",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "wrangler": "4.168.0"
  }
}
